.visual-refresh {
  --hdr-space: 230px;
  --grab-bar: 8px;

  /* thin title bar row instead of a full one */
  div[class*="base_"]:has(> div[class*="bar_"]) {
    position: relative;
    grid-template-rows: [top] var(--grab-bar) [titleBarEnd] min-content [noticeEnd] 1fr [contentEnd] min-content [end];
  }

  /* the grab bar itself */
  div[class*="base_"]:has(> div[class*="bar_"])::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--grab-bar);
    background: var(--background-base-lowest, #121214);
    z-index: 102;
    -webkit-app-region: drag;
  }

  /* keep the main content BELOW the buttons */
  div[class*="base_"] > div[class*="content_"] {
    z-index: 0;
  }

  /* float the title bar's buttons into the header, just under the grab bar */
  div[class*="base_"] > div[class*="bar_"] {
    position: absolute;
    top: var(--grab-bar);
    right: 0;
    width: auto;
    height: var(--custom-channel-header-height, 48px);
    z-index: 101;
    background: none;
    border: none;
  }

  div[class*="base_"] > div[class*="bar_"] > div[class*="title_"],
  div[class*="base_"] > div[class*="bar_"] > div[class*="leading_"] {
    display: none; /* delete the leading_ line if you want the back/forward arrows */
  }

  div[class*="base_"] > div[class*="bar_"] div[class*="trailing_"] {
    height: 100%;
    background: none;
    border: none;
  }

  [class*="trailing_"],
  [class*="trailing_"] *,
  [class*="winButtons_"],
  [class*="winButtons_"] * {
    -webkit-app-region: no-drag !important;
  }

  /* header: room for the buttons, no drag weirdness */
  section[class*="container_"][class*="themed_"] {
    padding-right: var(--hdr-space) !important;
    box-sizing: border-box;
  }

  section[class*="container_"][class*="themed_"],
  section[class*="container_"][class*="themed_"] * {
    -webkit-app-region: no-drag;
  }
}
