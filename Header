.visual-refresh {
  --hdr-space: 230px;

  /* collapse the title bar */
  div[class*="base_"]:has(> div[class*="bar_"]) {
    grid-template-rows: [top] 0 [titleBarEnd] min-content [noticeEnd] 1fr [contentEnd] min-content [end];
  }

  /* keep the main content BELOW the buttons */
  div[class*="base_"] > div[class*="content_"] {
    z-index: 0;
  }

  /* float the title bar's buttons into the top-right corner */
  div[class*="base_"] > div[class*="bar_"] {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    height: var(--custom-channel-header-height, 48px);
    z-index: 101;
    background: none;
    border: none;
  }

  div[class*="base_"] > div[class*="bar_"] > div[class*="title_"],
  div[class*="base_"] > div[class*="bar_"] > div[class*="leading_"] {
    display: none; /* delete the leading_ line if you want the back/forward arrows */
  }

  div[class*="base_"] > div[class*="bar_"] div[class*="trailing_"] {
    height: 100%;
    background: none;
    border: none;
  }

  [class*="trailing_"],
  [class*="trailing_"] *,
  [class*="winButtons_"],
  [class*="winButtons_"] * {
    -webkit-app-region: no-drag !important;
  }

  /* header: draggable, with room on the right for the buttons */
  section[class*="container_"][class*="themed_"] {
    position: relative;
    padding-right: var(--hdr-space) !important;
    box-sizing: border-box;
    -webkit-app-region: drag;
  }

  /* invisible "not draggable" patch where the buttons sit */
  section[class*="container_"][class*="themed_"]::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--hdr-space);
    -webkit-app-region: no-drag;
    pointer-events: none;
  }

  /* keep the header's own buttons/search clickable */
  section[class*="container_"][class*="themed_"] :is(
    button, a, input, [role="button"], [role="tab"],
    [class*="search"], [class*="toolbar_"]
  ) {
    -webkit-app-region: no-drag;
  }

  /* push the server list down so the top icon isn't cut off */
  ul[data-list-id="guildsnav"] > div[class*="itemsContainer_"] > div[class*="stack_"] {
    margin-top: 16px;
  }
}
