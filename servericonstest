:root {
  --guildbar-avatar-size: 48px;
  --guildbar-folder-size: var(--guildbar-avatar-size);

  --custom-guild-list-padding: 12px;
  --custom-guild-list-width: calc(
    max(var(--guildbar-avatar-size), var(--guildbar-folder-size))
    + (var(--custom-guild-list-padding) * 2)
  );

  --custom-folder-preview-gap: 0px;
  --custom-icon-radius: 50%;
  --custom-icon-selected-radius: 27%;
  --custom-icon-transition-speed: 150ms;
}

nav[class*="guilds"],
nav[aria-label="Servers"],
nav[data-list-id="guildsnav"] {
  width: var(--custom-guild-list-width);
}

/* Server list item sizing */
nav[class*="guilds"] [class*="listItem"],
nav[aria-label="Servers"] [class*="listItem"],
nav[data-list-id="guildsnav"] [class*="listItem"] {
  width: var(--custom-guild-list-width);
}

/* Only resize wrappers belonging directly to server-list items */
nav[class*="guilds"] [class*="listItem"] > [class*="wrapper"],
nav[aria-label="Servers"] [class*="listItem"] > [class*="wrapper"],
nav[data-list-id="guildsnav"] [class*="listItem"] > [class*="wrapper"],
nav[class*="guilds"] [class*="blobContainer"],
nav[aria-label="Servers"] [class*="blobContainer"],
nav[data-list-id="guildsnav"] [class*="blobContainer"],
nav[class*="guilds"] [class*="tutorialContainer"] [class*="wrapper"],
nav[aria-label="Servers"] [class*="tutorialContainer"] [class*="wrapper"],
nav[data-list-id="guildsnav"] [class*="tutorialContainer"] [class*="wrapper"] {
  width: var(--guildbar-avatar-size) !important;
  height: var(--guildbar-avatar-size) !important;
}

/* Server icon containers */
nav[class*="guilds"] [class*="blobContainer"],
nav[aria-label="Servers"] [class*="blobContainer"],
nav[data-list-id="guildsnav"] [class*="blobContainer"],
nav[class*="guilds"] [class*="childWrapper"],
nav[aria-label="Servers"] [class*="childWrapper"],
nav[data-list-id="guildsnav"] [class*="childWrapper"] {
  border-radius: var(--custom-icon-radius) !important;
  overflow: hidden;
  transition:
    border-radius var(--custom-icon-transition-speed) linear,
    background-color var(--custom-icon-transition-speed) linear;
}

/* Actual server images */
nav[class*="guilds"] img[class*="icon"],
nav[aria-label="Servers"] img[class*="icon"],
nav[data-list-id="guildsnav"] img[class*="icon"],
nav[class*="guilds"] [class*="childWrapper"] img,
nav[aria-label="Servers"] [class*="childWrapper"] img,
nav[data-list-id="guildsnav"] [class*="childWrapper"] img {
  display: block;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
  border-radius: inherit !important;
}

/* Rounded-square state when selected or hovered */
nav[class*="guilds"] [class*="listItem"]:hover [class*="blobContainer"],
nav[aria-label="Servers"] [class*="listItem"]:hover [class*="blobContainer"],
nav[data-list-id="guildsnav"] [class*="listItem"]:hover [class*="blobContainer"],
nav[class*="guilds"] [class*="listItem"]:hover [class*="childWrapper"],
nav[aria-label="Servers"] [class*="listItem"]:hover [class*="childWrapper"],
nav[data-list-id="guildsnav"] [class*="listItem"]:hover [class*="childWrapper"],
nav[class*="guilds"] [class*="selected"] [class*="blobContainer"],
nav[aria-label="Servers"] [class*="selected"] [class*="blobContainer"],
nav[data-list-id="guildsnav"] [class*="selected"] [class*="blobContainer"],
nav[class*="guilds"] [class*="selected"] [class*="childWrapper"],
nav[aria-label="Servers"] [class*="selected"] [class*="childWrapper"],
nav[data-list-id="guildsnav"] [class*="selected"] [class*="childWrapper"],
nav[class*="guilds"] [class*="blobContainer"][class*="selected"],
nav[aria-label="Servers"] [class*="blobContainer"][class*="selected"],
nav[data-list-id="guildsnav"] [class*="blobContainer"][class*="selected"],
nav[class*="guilds"] [class*="childWrapper"][class*="selected"],
nav[aria-label="Servers"] [class*="childWrapper"][class*="selected"],
nav[data-list-id="guildsnav"] [class*="childWrapper"][class*="selected"] {
  border-radius: var(--custom-icon-selected-radius) !important;
}

/* Home and add-server icons */
nav[class*="guilds"] [class*="childWrapper"] > svg,
nav[aria-label="Servers"] [class*="childWrapper"] > svg,
nav[data-list-id="guildsnav"] [class*="childWrapper"] > svg {
  width: calc(var(--guildbar-avatar-size) - 18px);
  height: calc(var(--guildbar-avatar-size) - 18px);
}

/* Circular icon buttons */
nav[class*="guilds"] [class*="circleIconButton"],
nav[aria-label="Servers"] [class*="circleIconButton"],
nav[data-list-id="guildsnav"] [class*="circleIconButton"] {
  width: var(--guildbar-avatar-size) !important;
  height: var(--guildbar-avatar-size) !important;
  border-radius: var(--custom-icon-radius) !important;
  transition: border-radius var(--custom-icon-transition-speed) linear;
}

nav[class*="guilds"] [class*="circleIconButton"]:hover,
nav[aria-label="Servers"] [class*="circleIconButton"]:hover,
nav[data-list-id="guildsnav"] [class*="circleIconButton"]:hover,
nav[class*="guilds"] [class*="circleIconButton"][class*="selected"],
nav[aria-label="Servers"] [class*="circleIconButton"][class*="selected"],
nav[data-list-id="guildsnav"] [class*="circleIconButton"][class*="selected"] {
  border-radius: var(--custom-icon-selected-radius) !important;
}

/* Drag-and-drop indicators */
nav[class*="guilds"] [class*="dragInner"],
nav[aria-label="Servers"] [class*="dragInner"],
nav[data-list-id="guildsnav"] [class*="dragInner"] {
  width: 40px;
  height: 40px;
}

nav[class*="guilds"] [class*="dragOver"][class*="target"]::before,
nav[aria-label="Servers"] [class*="dragOver"][class*="target"]::before,
nav[data-list-id="guildsnav"] [class*="dragOver"][class*="target"]::before {
  left: calc(var(--guildbar-avatar-size) / 4);
  width: 100%;
}

nav[class*="guilds"] [class*="dragOver"][class*="centerTarget"]::before,
nav[aria-label="Servers"] [class*="dragOver"][class*="centerTarget"]::before,
nav[data-list-id="guildsnav"] [class*="dragOver"][class*="centerTarget"]::before {
  top: calc((var(--guildbar-avatar-size) / 2) + 8px);
}

/* Shifted SVG and badge positioning */
nav[class*="guilds"] [class*="shiftSVG"],
nav[aria-label="Servers"] [class*="shiftSVG"],
nav[data-list-id="guildsnav"] [class*="shiftSVG"] {
  top: 0;
  left: 0;
}

nav[class*="guilds"] [class*="shiftSVG"] foreignObject,
nav[aria-label="Servers"] [class*="shiftSVG"] foreignObject,
nav[data-list-id="guildsnav"] [class*="shiftSVG"] foreignObject {
  transform: translate(-4px, -4px);
}

/*
 * Preserve badge offsets without modifying Discord's blob masks.
 * This avoids the bug that caused icons to become invisible.
 */
nav[class*="guilds"] mask,
nav[aria-label="Servers"] mask,
nav[data-list-id="guildsnav"] mask {
  --badge-offset: calc(var(--guildbar-avatar-size) - 40px);
}

nav[class*="guilds"]
  :not([class*="folderHeader"])
  mask
  use[href$="lower_badge_masks"],
nav[aria-label="Servers"]
  :not([class*="folderHeader"])
  mask
  use[href$="lower_badge_masks"],
nav[data-list-id="guildsnav"]
  :not([class*="folderHeader"])
  mask
  use[href$="lower_badge_masks"] {
  translate: var(--badge-offset) var(--badge-offset);
}

nav[class*="guilds"]
  :not([class*="folderHeader"])
  mask
  use[href$="upper_badge_masks"],
nav[aria-label="Servers"]
  :not([class*="folderHeader"])
  mask
  use[href$="upper_badge_masks"],
nav[data-list-id="guildsnav"]
  :not([class*="folderHeader"])
  mask
  use[href$="upper_badge_masks"] {
  translate: var(--badge-offset);
}

/* Folder button */
nav[class*="guilds"] [class*="folderButton"],
nav[aria-label="Servers"] [class*="folderButton"],
nav[data-list-id="guildsnav"] [class*="folderButton"] {
  overflow: visible;
}

nav[class*="guilds"] [class*="folderHeader"],
nav[aria-label="Servers"] [class*="folderHeader"],
nav[data-list-id="guildsnav"] [class*="folderHeader"] {
  width: var(--guildbar-folder-size) !important;
  height: var(--guildbar-folder-size) !important;
}

/* Folder icon */
nav[class*="guilds"] [class*="folderIcon"],
nav[aria-label="Servers"] [class*="folderIcon"],
nav[data-list-id="guildsnav"] [class*="folderIcon"] {
  width: var(--guildbar-folder-size) !important;
  height: var(--guildbar-folder-size) !important;
  background-color: var(--bg-mod-subtle);
}

nav[class*="guilds"] [class*="folderIcon"] svg,
nav[aria-label="Servers"] [class*="folderIcon"] svg,
nav[data-list-id="guildsnav"] [class*="folderIcon"] svg {
  width: 24px !important;
  height: 24px !important;
}

/* Folder preview layout */
nav[class*="guilds"] [class*="folderPreviewWrapper"],
nav[aria-label="Servers"] [class*="folderPreviewWrapper"],
nav[data-list-id="guildsnav"] [class*="folderPreviewWrapper"] {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--guildbar-folder-size);
  height: var(--guildbar-folder-size);
}

nav[class*="guilds"] [class$="folderPreview"],
nav[aria-label="Servers"] [class$="folderPreview"],
nav[data-list-id="guildsnav"] [class$="folderPreview"] {
  width: calc(
    (var(--guildbar-folder-size) * 2 / 3)
    + var(--custom-folder-preview-gap)
  );
  height: calc(
    (var(--guildbar-folder-size) * 2 / 3)
    + var(--custom-folder-preview-gap)
  );
}

/* Mini server icons inside closed-folder previews */
nav[class*="guilds"] [class*="iconSizeMini"],
nav[aria-label="Servers"] [class*="iconSizeMini"],
nav[data-list-id="guildsnav"] [class*="iconSizeMini"] {
  width: calc(var(--guildbar-folder-size) / 3);
  height: calc(var(--guildbar-folder-size) / 3);
  overflow: hidden;
}

nav[class*="guilds"] [class*="iconSizeMini"] [class*="acronym"],
nav[aria-label="Servers"] [class*="iconSizeMini"] [class*="acronym"],
nav[data-list-id="guildsnav"] [class*="iconSizeMini"] [class*="acronym"] {
  line-height: calc(var(--guildbar-folder-size) / 3);
}

nav[class*="guilds"] [class*="iconSizeMini"][style*="font-size: 12px;"],
nav[aria-label="Servers"] [class*="iconSizeMini"][style*="font-size: 12px;"],
nav[data-list-id="guildsnav"] [class*="iconSizeMini"][style*="font-size: 12px;"] {
  font-size: 10px !important;
}

nav[class*="guilds"] [class*="iconSizeMini"][style*="font-size: 10px;"],
nav[aria-label="Servers"] [class*="iconSizeMini"][style*="font-size: 10px;"],
nav[data-list-id="guildsnav"] [class*="iconSizeMini"][style*="font-size: 10px;"] {
  font-size: 7px !important;
}

nav[class*="guilds"] [class*="iconSizeMini"][style*="font-size: 8px;"],
nav[aria-label="Servers"] [class*="iconSizeMini"][style*="font-size: 8px;"],
nav[data-list-id="guildsnav"] [class*="iconSizeMini"][style*="font-size: 8px;"] {
  font-size: 6px !important;
}

/* Keep folder-preview images centred and cropped */
nav[class*="guilds"] [class*="folderPreview"] img,
nav[aria-label="Servers"] [class*="folderPreview"] img,
nav[data-list-id="guildsnav"] [class*="folderPreview"] img,
nav[class*="guilds"] [class*="folderPreviewGuildIcon"],
nav[aria-label="Servers"] [class*="folderPreviewGuildIcon"],
nav[data-list-id="guildsnav"] [class*="folderPreviewGuildIcon"] {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Expanded folders */
nav[class*="guilds"] [class*="isExpanded"] [class*="stack"],
nav[aria-label="Servers"] [class*="isExpanded"] [class*="stack"],
nav[data-list-id="guildsnav"] [class*="isExpanded"] [class*="stack"] {
  height: auto !important;
}

nav[class*="guilds"]
  [class*="isExpanded"]
  [class*="folderGroupBackground"],
nav[aria-label="Servers"]
  [class*="isExpanded"]
  [class*="folderGroupBackground"],
nav[data-list-id="guildsnav"]
  [class*="isExpanded"]
  [class*="folderGroupBackground"] {
  border-bottom-left-radius: 24px;
  border-bottom-right-radius: 24px;
}

/* Unread direct-message icons */
nav[class*="guilds"] #guild-list-unread-dms > div,
nav[aria-label="Servers"] #guild-list-unread-dms > div,
nav[data-list-id="guildsnav"] #guild-list-unread-dms > div {
  height: var(--guildbar-avatar-size) !important;
}

/* Safe foreignObject centring */
nav[class*="guilds"] svg foreignObject > div,
nav[aria-label="Servers"] svg foreignObject > div,
nav[data-list-id="guildsnav"] svg foreignObject > div {
  width: 100%;
  height: 100%;
}

/*
 * Do not override:
 * - defs > path
 * - mask path geometry
 * - blob_mask scale
 *
 * Discord relies on those SVG definitions to display its server icons.
 */
