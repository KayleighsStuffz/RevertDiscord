/* Force every server icon to remain completely circular */
nav[class*="guilds"] [class*="blobContainer"],
nav[aria-label="Servers"] [class*="blobContainer"],
nav[data-list-id="guildsnav"] [class*="blobContainer"],
nav[class*="guilds"] [class*="childWrapper"],
nav[aria-label="Servers"] [class*="childWrapper"],
nav[data-list-id="guildsnav"] [class*="childWrapper"],
nav[class*="guilds"] [class*="circleIconButton"],
nav[aria-label="Servers"] [class*="circleIconButton"],
nav[data-list-id="guildsnav"] [class*="circleIconButton"] {
  border-radius: 50% !important;
  overflow: hidden !important;
}

/* Disable Discord's rounded-square SVG clipping mask */
nav[class*="guilds"] svg:not([class*="placeholderMask"]) > foreignObject,
nav[aria-label="Servers"] svg:not([class*="placeholderMask"]) > foreignObject,
nav[data-list-id="guildsnav"] svg:not([class*="placeholderMask"]) > foreignObject {
  width: var(--guildbar-avatar-size) !important;
  height: var(--guildbar-avatar-size) !important;
  mask: none !important;
  border-radius: 50% !important;
  overflow: hidden !important;
}

/* Ensure server images completely fill their circular containers */
nav[class*="guilds"] svg foreignObject > div,
nav[aria-label="Servers"] svg foreignObject > div,
nav[data-list-id="guildsnav"] svg foreignObject > div {
  display: flex !important;
  width: 100% !important;
  height: 100% !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 50% !important;
  overflow: hidden !important;
}

nav[class*="guilds"] svg foreignObject img,
nav[aria-label="Servers"] svg foreignObject img,
nav[data-list-id="guildsnav"] svg foreignObject img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  border-radius: 50% !important;
}

/* Centre the Discord/Home button */
nav[class*="guilds"] [class*="tutorialContainer"],
nav[aria-label="Servers"] [class*="tutorialContainer"],
nav[data-list-id="guildsnav"] [class*="tutorialContainer"] {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

nav[class*="guilds"] [class*="tutorialContainer"] [class*="childWrapper"],
nav[aria-label="Servers"] [class*="tutorialContainer"] [class*="childWrapper"],
nav[data-list-id="guildsnav"] [class*="tutorialContainer"] [class*="childWrapper"] {
  display: flex !important;
  width: var(--guildbar-avatar-size) !important;
  height: var(--guildbar-avatar-size) !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
}

/* Undo any inherited offsets on the Discord logo */
nav[class*="guilds"] [class*="tutorialContainer"] [class*="childWrapper"] > svg,
nav[aria-label="Servers"] [class*="tutorialContainer"] [class*="childWrapper"] > svg,
nav[data-list-id="guildsnav"] [class*="tutorialContainer"] [class*="childWrapper"] > svg {
  position: static !important;
  display: block !important;
  width: 30px !important;
  height: 30px !important;
  margin: auto !important;
  translate: none !important;
  transform: none !important;
}
